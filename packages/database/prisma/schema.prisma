generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  waNumber  String?
  status    String   // active, expired, crashed
  data      Json?    // Session cookies/state
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  to        String
  body      String
  status    String   // queued, sent, failed
  error     String?
  scheduledAt DateTime?
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id        String   @id @default(cuid())
  type      String   // send_message, session_check, etc
  payload   Json
  status    String   // pending, active, completed, failed
  attempts  Int      @default(0)
  logs      JobLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobLog {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  message   String
  level     String   // info, error
  createdAt DateTime @default(now())
}
